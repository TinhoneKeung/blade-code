{
  "files.autoSave": "afterDelay",
  "eslint.format.enable": false,
  "eslint.validate": [],
  "eslint.probe": [],
  "editor.codeLens": true,
  "editor.codeActionsOnSave": {
    "source.addMissingImports": "explicit",
    "source.organizeImports": "explicit",
    "source.fixAll.eslint": "never"
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "workbench.colorCustomizations": {
    "tab.activeBackground": "#D87858",
    "debugIcon.startForeground": "#42443A",
    "debugIcon.stepBackForeground": "#252729",
    "debugIcon.stepIntoForeground": "#252729",
    "debugIcon.stepOutForeground": "#252729",
    "debugIcon.stepOverForeground": "#252729",
    "debugIcon.stopForeground": "#252729",
    "debugIcon.pauseForeground": "#252729",
    "debugIcon.restartForeground": "#252729",
    "debugIcon.continueForeground": "#252729",
    "debugIcon.breakpointDisabledForeground": "#42443A",
    "debugIcon.breakpointUnverifiedForeground": "#42443A",
    "debugIcon.disconnectForeground": "#252729",
    "debugIcon.breakpointStackframeForeground": "#42443A",
    "debugIcon.breakpointCurrentStackframeForeground": "#42443A",
    "debugIcon.breakpointForeground": "#4B4B4B",
    "debugToolBar.background": "#252729",
    "debugToolBar.border": "#252729",
    "titleBar.activeBackground": "#252729",
    "debugTokenExpression.string": "#bc6060",
    "debugTokenExpression.boolean": "#C9C9C9",
    "debugTokenExpression.number": "#C9C9C9",
    "statusBar.debuggingBorder": "#ff0000",
    "statusBar.debuggingBackground": "#ff0000",
    "debugConsole.errorForeground": "#C9C9C9",
    "debugConsole.infoForeground": "#3794ff",
    "debugConsole.sourceForeground": "#fa2b2d",
    "debugConsoleInputIcon.foreground": "#fa2b2d",
    "debugTokenExpression.value": "#C9C9C9",
    "debugTokenExpression.name": "#C9C9C9",
    "editor.stackFrameHighlightBackground": "#2B2D2F",
    "editor.focusedStackFrameHighlightBackground": "#272823",
    "debugExceptionWidget.background": "#fa2b2d",
    "debugExceptionWidget.border": "#fa2b2d",
    "commandCenter.debuggingBackground": "#25272900",
    "debugView.exceptionLabelBackground": "#fa2b2d",
    "debugView.exceptionLabelForeground": "#fa2b2d",
    "debugView.stateLabelBackground": "#282A24",
    // "debugView.stateLabelForeground": "#fa2b2d",
    // "debugView.valueChangedHighlight": "#fa2b2d",
  },
  "debug.hideLauncherWhileDebugging": true,
  "debug.console.wordWrap": false,
  "debug.disassemblyView.showSourceCode": true,
  "debug.enableStatusBarColor": false,
  "debug.toolBarLocation": "commandCenter",
  "debug.showInStatusBar": "always",
  "debug.allowBreakpointsEverywhere": true,
  "bun.runtime": "/Users/justinhone/.bun/bin/bun",
  // If support for Bun should be added to the default "JavaScript Debug Terminal".
  "bun.debugTerminal.enabled": true,
  // If the debugger should stop on the first line of the program.
  "bun.debugTerminal.stopOnEntry": true,
  // Glob pattern to find test files. Defaults to the value shown below.
  "bun.test.filePattern": "**/*{.test.,.spec.,_test_,_spec_}{js,ts,tsx,jsx,mts,cts,cjs,mjs}",
  // The custom script to call for testing instead of `bun test`
  "bun.test.customScript": "bun test",
}